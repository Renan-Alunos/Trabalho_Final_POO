@startuml
title Farma Aura - Diagrama completo da Sprint 4
skinparam classAttributeIconSize 0
skinparam linetype ortho
left to right direction
hide circle
class Sistema {
  - usuarios: List~<Usuario~>
  - catalogo: Catalogo
  - pedidosAbertos: List~<Pedido~>
  - pedidosFinalizados: List~<Pedido~>
  - proximoNumeroPedido: int
  - observadores: List~<ObservadorSistema~>
  + adicionarObservador(ObservadorSistema): void
  + removerObservador(ObservadorSistema): void
  - avisarObservadores(): void
  + Sistema()
  + fazerLogin(String, String): Usuario
  + cadastrarCliente(String, String, String): Cliente
  + buscarClientes(String): String
  + listarProdutos(): List~<Produto~>
  + cadastrarProduto(Funcionario, int, String, double, int): boolean
  + alterarPreco(Funcionario, int, double): boolean
  + reporEstoque(Funcionario, int, int): boolean
  + criarPedido(Cliente): Pedido
  + adicionarItem(Pedido, int, int): boolean
  + definirQuantidadeItem(Pedido, int, int): boolean
  + cancelarPedido(Pedido): boolean
  + finalizarPedido(Pedido, String): boolean
  + finalizarPedido(Pedido, Pagamento): boolean
  + listarPedidos(): List~<Pedido~>
  + listarPedidos(Cliente): List~<Pedido~>
  + calcularTotalVendas(): double
  - funcionarioValido(Funcionario): boolean
  + listarPedidos(Funcionario): List~<Pedido~>
  + gerarRelatorioVendas(): String
}
class Catalogo {
  - produtos: List~<Produto~>
  + Catalogo()
  + adicionarProduto(Produto): void
  + buscarProduto(int): Produto
  + getProdutos(): List~<Produto~>
}
class Produto {
  - codigo: int
  - nome: String
  - preco: double
  - quantidade: int
  + Produto(int, String, double, int)
  + getCodigo(): int
  + getNome(): String
  + getPreco(): double
  + getQuantidade(): int
  + alterarPreco(double): void
  + adicionarEstoque(int): void
  + retirarEstoque(int): boolean
}
class Pedido {
  - numero: int
  - cliente: Cliente
  - itens: List~<ItemPedido~>
  - situacao: String
  - formaPagamento: String
  + Pedido(int, Cliente)
  + getNumero(): int
  + getCliente(): Cliente
  + adicionarItem(ItemPedido): void
  + definirQuantidade(Produto, int): void
  + quantidadeDoProduto(Produto): long
  + getItens(): List~<ItemPedido~>
  + getSituacao(): String
  + getFormaPagamento(): String
  + finalizar(String): void
  + calcularTotal(): double
}
class ItemPedido {
  - produto: Produto
  - quantidade: int
  - precoUnitario: double
  + ItemPedido(Produto, int)
  + getProduto(): Produto
  + getQuantidade(): int
  + getPrecoUnitario(): double
  + calcularSubtotal(): double
}
class Usuario {
  - nome: String
  - cpf: String
  - senha: String
  + Usuario(String, String, String)
  + getNome(): String
  + getSenha(): String
  + getCpf(): String
  + getTipoUsuario(): String
}
class Cliente {
  - pedidos: List~<Pedido~>
  + Cliente(String, String, String)
  + adicionarPedido(Pedido): void
  + getPedidos(): List~<Pedido~>
  + getTipoUsuario(): String
}
class Funcionario {
  - matricula: String
  + Funcionario(String, String, String, String)
  + getMatricula(): String
  + getTipoUsuario(): String
  + alterarPreco(Produto, double): void
  + adicionarProduto(Catalogo, Produto): void
}
class EstoqueInsuficienteException {
  + EstoqueInsuficienteException(String, int)
}
interface ObservadorSistema {
  + sistemaAtualizado(): void
}
class Pagamento {
  - processador: ProcessadorPagamento
  + Pagamento(String)
  + getForma(): String
  + processarPagamento(double): boolean
}
interface ProcessadorPagamento {
  + getForma(): String
  + processar(double): boolean
}
class PagamentoPix {
  + PagamentoPix()
  + getForma(): String
  + processar(double): boolean
}
class PagamentoCartao {
  + PagamentoCartao()
  + getForma(): String
  + processar(double): boolean
}
abstract class CriadorPagamento {
  + CriadorPagamento()
  + criar(): ProcessadorPagamento
}
class CriadorPix {
  + CriadorPix()
  + criar(): ProcessadorPagamento
}
class CriadorCartao {
  + CriadorCartao()
  + criar(): ProcessadorPagamento
}
class Main {
  - teclado: Scanner
  - sistema: Sistema
  + Main()
  + main(String[]): void
  - cadastrarCliente(): void
  - fazerLogin(): void
  - menuFuncionario(Funcionario): void
  - menuCliente(Cliente): void
  - exigirPedido(Pedido): void
  - mostrarProdutos(): void
  - mostrarDetalhesPedido(Pedido): void
  - mostrarPedidos(List~<Pedido~>): void
  - lerInteiro(String): int
  - lerDecimal(String): double
  - lerTexto(String): String
  - dinheiro(double): String
}
class TelaFarmacia {
  - campoCpf: JTextField
  - campoSenha: JPasswordField
  - sistema: Sistema
  + TelaFarmacia()
  - mostrarTelaLogin(): void
  - fazerLogin(): void
  - mostrarTelaCadastro(): void
  - cadastrarCliente(String, String, String): void
  - mostrarCatalogo(): void
  - mostrarTelaCliente(Cliente): void
  - mostrarTelaFuncionario(Funcionario): void
  + voltarAoLogin(): void
  + main(String[]): void
}
class TelaCliente {
  - sistema: Sistema
  - clienteAtual: Cliente
  - onSair: Runnable
  - pedidoAtual: Pedido
  - carrinho: Map~<Integer, Integer~>
  - painelProdutos: JPanel
  - resumoCarrinho: JTextArea
  - valorTotal: JLabel
  - pagamento: JComboBox~<String~>
  - azul: Color
  - observador: ObservadorSistema
  + TelaCliente(Sistema, Cliente, Runnable)
  - titulo(String): JLabel
  - botao(String): JButton
  - montarTela(): void
  - atualizarTelaCliente(): void
  - dinheiro(double): String
  - atualizarResumo(): void
  - alterarQuantidade(Produto, int): void
  - finalizarPedido(): void
  - mostrarHistorico(): void
  - sairDaConta(): void
}
class TelaFuncionario {
  - sistema: Sistema
  - funcionario: Funcionario
  - telaLogin: TelaFarmacia
  - abas: JTabbedPane
  - modeloProdutos: DefaultTableModel
  - campoCadCodigo: JTextField
  - campoCadNome: JTextField
  - campoCadPreco: JTextField
  - campoCadEstoque: JTextField
  - campoPrecoCodigo: JTextField
  - campoPrecoNovo: JTextField
  - campoEstoqueCodigo: JTextField
  - campoEstoqueQtd: JTextField
  - areaPedidos: JTextArea
  - areaRelatorio: JTextArea
  - observador: ObservadorSistema
  + TelaFuncionario(Sistema, Funcionario, TelaFarmacia)
  - criarTopo(): JPanel
  - criarRodape(): JPanel
  - criarAbaProdutos(): JPanel
  - criarAbaTexto(JTextArea): JPanel
  - criarFormulario(String, String[], JTextField[], String, Runnable): JPanel
  - botaoAzul(String): JButton
  - cadastrarProduto(): void
  - alterarPreco(): void
  - reporEstoque(): void
  - sairDaConta(): void
  - atualizarTudo(): void
  - atualizarProdutos(): void
  - atualizarPedidos(): void
  - lerDecimal(String): double
  - dinheiro(double): String
  - mensagem(String): void
}
class TelaCliente_Comentada {
  - sistema: Sistema
  - clienteAtual: Cliente
  - onSair: Runnable
  - pedidoAtual: Pedido
  - carrinho: Map~<Integer, Integer~>
  - painelProdutos: JPanel
  - resumoCarrinho: JTextArea
  - valorTotal: JLabel
  - pagamento: JComboBox~<String~>
  - azul: Color
  + TelaCliente_Comentada(Sistema, Cliente, Runnable)
  - titulo(String): JLabel
  - botao(String): JButton
  - montarTela(): void
  - atualizarTelaCliente(): void
  - dinheiro(double): String
  - atualizarResumo(): void
  - alterarQuantidade(Produto, int): void
  - finalizarPedido(): void
  - mostrarHistorico(): void
  - sairDaConta(): void
}
Usuario <|-- Cliente
Usuario <|-- Funcionario
ProcessadorPagamento <|.. PagamentoPix
ProcessadorPagamento <|.. PagamentoCartao
CriadorPagamento <|-- CriadorPix
CriadorPagamento <|-- CriadorCartao
CriadorPix ..> PagamentoPix : cria
CriadorCartao ..> PagamentoCartao : cria
Pagamento --> ProcessadorPagamento : usa
Pagamento ..> CriadorPagamento : cria estrategia
Sistema *-- Catalogo
Sistema o-- Usuario
Sistema o-- Pedido
Catalogo o-- Produto
Pedido *-- ItemPedido
Pedido --> Cliente
ItemPedido --> Produto
Sistema ..> EstoqueInsuficienteException : lanca
Sistema ..> ObservadorSistema : notifica
Sistema ..> Pagamento : finaliza
Main ..> Sistema
TelaFarmacia ..> Sistema
TelaFarmacia ..> TelaCliente : abre
TelaFarmacia ..> TelaFuncionario : abre
TelaCliente ..> Sistema
TelaCliente --> Cliente
TelaCliente --> Pedido
TelaFuncionario ..> Sistema
TelaFuncionario --> Funcionario
TelaCliente ..> ObservadorSistema : se registra
TelaFuncionario ..> ObservadorSistema : se registra
note right of TelaCliente_Comentada
  Copia comentada da Sprint 3 mantida no projeto.
  Nao e usada para abrir a interface.
end note
@enduml
